# Formspree contact form backend (no DNS setup required)
# 1. Create account at https://formspree.io
# 2. Create a new form
# 3. Copy the endpoint URL (format: https://formspree.io/f/{form_id})
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# CV / Resume download link (used in Hero secondary CTA; hides button if unset)
NEXT_PUBLIC_RESUME_URL=

# OpenAI API Key (Required for structured output demos: Resume Analyzer, Project Recommender, Technical Audit)
OPENAI_API_KEY=

# Anthropic API Key (Required for FloatingChatbot demo)
ANTHROPIC_API_KEY=

# Toggle Hero Availability status badge (true/false)
NEXT_PUBLIC_AVAILABLE_FOR_HIRE=true

