# ================================================================
# ENVIRONMENT VARIABLES - Portfolio 2026
# ================================================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file and rename to: .env.local
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit this file to Git (already in .gitignore)
# 4. Add these same variables to Vercel dashboard for production
#
# ================================================================

# ----------------------------------------------------------------
# OpenAI API Configuration (REQUIRED)
# ----------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# This powers all AI features (Chatbot, Project Recommender, Resume Analyzer)
# 
# Cost estimate: ~$5-10/month for moderate usage with rate limiting
# Rate limits set in code: 10-20 requests/hour per IP
#
OPENAI_API_KEY=


# ----------------------------------------------------------------
# Site Configuration (REQUIRED)
# ----------------------------------------------------------------
# Your production domain (used for SEO metadata)
NEXT_PUBLIC_SITE_URL=https://olabodeolusegun.com

# Site name for metadata
NEXT_PUBLIC_SITE_NAME="Olabode Olusegun - Full-Stack Engineer"

# Your contact email
NEXT_PUBLIC_CONTACT_EMAIL=olabodewebdesigns02@gmail.com


# ----------------------------------------------------------------
# Analytics & Monitoring (OPTIONAL - Recommended)
# ----------------------------------------------------------------
# Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Vercel Analytics (auto-enabled on Vercel, no config needed)
# Vercel Speed Insights (auto-enabled on Vercel, no config needed)


# ----------------------------------------------------------------
# Error Tracking (OPTIONAL - Recommended for Production)
# ----------------------------------------------------------------
# Sentry DSN for error monitoring
# Get from: https://sentry.io/
# Uncomment and add your DSN if using Sentry
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry Environment
# SENTRY_ENVIRONMENT=production


# ----------------------------------------------------------------
# Rate Limiting (OPTIONAL - For Production Scale)
# ----------------------------------------------------------------
# Upstash Redis for distributed rate limiting
# Get from: https://upstash.com/ (Free tier available)
# Recommended for production to prevent API abuse across multiple servers
#
# Without these, the app uses in-memory rate limiting (resets on server restart)
# With these, rate limits persist across deployments
#
# UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-redis-token-here


# ----------------------------------------------------------------
# Email Service (OPTIONAL - For Contact Form)
# ----------------------------------------------------------------
# If you want to add a working contact form (currently uses mailto:)
# Consider using: Resend, SendGrid, or Mailgun
#
# Resend API Key (https://resend.com/)
# RESEND_API_KEY=re_your-resend-api-key
#
# SendGrid API Key (https://sendgrid.com/)
# SENDGRID_API_KEY=SG.your-sendgrid-api-key


# ----------------------------------------------------------------
# Social Media Links (OPTIONAL - For Dynamic Links)
# ----------------------------------------------------------------
# These are currently hardcoded in components, but you can make them dynamic
# NEXT_PUBLIC_GITHUB_URL=https://github.com/thewebguyy
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/olabode-olusegun-8328141bb/
# NEXT_PUBLIC_TWITTER_URL=https://twitter.com/thewebguyy
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/thewebguyy/


# ----------------------------------------------------------------
# Resume/CV Link (OPTIONAL - For Dynamic CV Link)
# ----------------------------------------------------------------
# Currently hardcoded, but can be made dynamic
# NEXT_PUBLIC_RESUME_URL=https://drive.google.com/file/d/your-cv-id/view


# ----------------------------------------------------------------
# Feature Flags (OPTIONAL - For A/B Testing)
# ----------------------------------------------------------------
# Enable/disable features without code changes
# NEXT_PUBLIC_ENABLE_CHATBOT=true
# NEXT_PUBLIC_ENABLE_RESUME_ANALYZER=true
# NEXT_PUBLIC_ENABLE_PROJECT_RECOMMENDER=true
# NEXT_PUBLIC_ENABLE_PLAYGROUND=true


# ----------------------------------------------------------------
# Environment (AUTO-DETECTED)
# ----------------------------------------------------------------
# Automatically set by Next.js
# development | production | test
# NODE_ENV=production


# ================================================================
# VERCEL DEPLOYMENT NOTES
# ================================================================
#
# When deploying to Vercel:
# 1. Go to: https://vercel.com/dashboard
# 2. Select your project
# 3. Go to Settings → Environment Variables
# 4. Add each variable above (except comments)
# 5. Set scope: Production, Preview, Development (as needed)
#
# CRITICAL: Add OPENAI_API_KEY to Vercel or AI features will fail!
#
# ================================================================


# ================================================================
# SECURITY REMINDERS
# ================================================================
#
# ✅ DO:
# - Keep this file in .gitignore
# - Use different API keys for dev/prod
# - Rotate keys if accidentally exposed
# - Monitor API usage on OpenAI dashboard
# - Set up billing alerts
#
# ❌ DON'T:
# - Commit this file to Git
# - Share API keys publicly
# - Use production keys in development
# - Expose keys in client-side code
# - Ignore rate limiting
#
# ================================================================


# ================================================================
# COST MANAGEMENT
# ================================================================
#
# OpenAI API Costs (with current rate limits):
# - Project Recommender: ~$0.02 per request
# - Resume Analyzer: ~$0.03 per request  
# - Chatbot: ~$0.01 per message
#
# Monthly estimate with moderate traffic:
# - 500 recommendations/month = $10
# - 200 resume analyses/month = $6
# - 1000 chat messages/month = $10
# TOTAL: ~$26/month (well within free trial $5 credit + paid plans)
#
# Rate limits prevent runaway costs:
# - Max 10 recommendations/hour/IP = 7,200/month max
# - Max 5 analyses/hour/IP = 3,600/month max
# - Max 20 messages/hour/IP = 14,400/month max
#
# Set up billing alerts at: https://platform.openai.com/account/billing
#
# ================================================================


# ================================================================
# TROUBLESHOOTING
# ================================================================
#
# Issue: "Missing OPENAI_API_KEY"
# Fix: Ensure this file is named exactly .env.local (not .env.local.txt)
#
# Issue: API calls failing with 401
# Fix: Check API key is valid at https://platform.openai.com/api-keys
#
# Issue: Rate limit errors immediately
# Fix: Clear your IP from rate limit store (restart dev server)
#
# Issue: Changes not applying
# Fix: Restart dev server after modifying .env.local
#
# ================================================================


# ================================================================
# EXAMPLE CONFIGURATION (STARTER TEMPLATE)
# ================================================================
#
# Minimal working setup (just AI features):
# OPENAI_API_KEY=sk-proj-abc123...
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_NAME="My Portfolio"
# NEXT_PUBLIC_CONTACT_EMAIL=your.email@example.com
#
# ================================================================